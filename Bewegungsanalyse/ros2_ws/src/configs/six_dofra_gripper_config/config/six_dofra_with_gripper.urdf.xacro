<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dofra_with_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import six_dofra_with_gripper urdf file -->
    <xacro:include filename="$(find application_description)/urdf/application_description.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="six_dofra_with_gripper.ros2_control.xacro" />


    <xacro:six_dofra_with_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
