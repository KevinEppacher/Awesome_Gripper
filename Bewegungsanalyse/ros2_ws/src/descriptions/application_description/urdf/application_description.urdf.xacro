<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dofra_with_gripper">
    
    <!-- Define a math prefix for degree to radian conversion -->
    <xacro:property name="deg_to_rad" value="0.01745329252" /> <!-- pi/180 -->
    
    <!-- Load Six Dofra Robot Description -->
    <xacro:include filename="$(find six_dofra_description)/urdf/six_dofra_description.urdf.xacro" />
    
    <!-- Load Gripper Description -->
    <xacro:include filename="$(find gripper)/urdf/gripper.urdf.xacro" />

    <!-- Fixed joint between robot and gripper -->
    <joint name="robot_to_gripper" type="fixed">
        <origin xyz="0 0 0" rpy="${0 * deg_to_rad} ${0 * deg_to_rad} ${-90 * deg_to_rad}"/>
        <parent link="tool_nullframe_link"/>
        <child link="gripper_mount_link"/>
    </joint>
    
</robot>