    <joint name="joint_3" type="revolute">
        <origin xyz="0 0.15 0" rpy="3.14159265358979 0 3.14159265358979" />
        <parent link="link_2" />
        <child link="link_3" />
        <axis xyz="0 0 1" />
        <limit lower="-3.1416" upper="3.1416" effort="5" velocity="3.14" />
