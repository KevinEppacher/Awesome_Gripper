        <origin xyz="0.0104999999999973 0.0349999999999985 0.0524909444637412" rpy="0 1.5707963267949 0" />
        <parent link="link_3" />
        <child link="link_4" />
        <axis xyz="0 0 -1" />
        <limit lower="-3.1416" upper="3.1416" effort="5" velocity="3.14" />
